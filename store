#!/bin/bash

# Ensure a source directory is provided
if [ "$#" -ne 1 ]; then
    echo "Usage: $0 source_directory"
    exit 1
fi

SOURCE_DIR=$1

# Run the copy inside a detached screen session, keeping the Mac awake
caffeinate -i screen -S photocopy -L -Logfile copy_log.txt photocopier copy "$SOURCE_DIR" /Volumes/6TB2/photocopied
